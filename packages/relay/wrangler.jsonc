{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "tesserae-relay",
	"main": "src/index.js",
	"compatibility_date": "2026-07-01",
	// Sealed frames + the small install/token/pairing records all live in one
	// R2 bucket (strongly consistent; the free tier covers a household). Create
	// it with: wrangler r2 bucket create tesserae-relay
	"r2_buckets": [
		{
			"binding": "RELAY_BUCKET",
			"bucket_name": "tesserae-relay"
		}
	],
	"observability": {
		"enabled": true
	},
	// Aggregate operational metrics (frames pushed, mailboxes created/removed)
	// for a dashboard. Optional: the Worker no-ops without it, so remove this
	// binding if you don't want analytics. Query via the Analytics Engine SQL
	// API (see README.md); the dataset is created on first write.
	"analytics_engine_datasets": [
		{
			"binding": "ANALYTICS",
			"dataset": "relay_events"
		}
	]
	// Optional cap on frame uploads per panel per UTC day; unset means
	// unlimited. Past the cap the relay answers 429 rate_limited and the panel
	// keeps its last frame until 00:00 UTC. The hosted relay sets this:
	// "vars": { "FRAME_DAILY_LIMIT": "750" },
	//
	// The relay is zero-knowledge: it stores opaque sealed frames and never
	// holds a frame key, so there are no signing secrets to configure. Gate
	// hosted registration by overriding checkEntitlement() in src/index.js.
}
